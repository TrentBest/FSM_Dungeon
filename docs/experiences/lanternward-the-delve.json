{
  "schemaVersion": "1.0",
  "id": "fsm-dungeon.experience.lanternward-the-delve",
  "title": "Lanternward: The Delve",
  "status": "design",
  "originality": {
    "workshopOriginal": true,
    "thirdPartyAssets": false,
    "thirdPartyRuleText": false,
    "affiliation": "none",
    "policy": "All rules, names, maps, scenarios, characters, and assets are independently authored. Genre conventions may inform design but third-party expression is not copied."
  },
  "domain": {
    "package": "TheSingularityWorkshop.FSM_Dungeon",
    "capability": "fsm-dungeon.underground-environment",
    "versionPolicy": "pinned"
  },
  "integrations": {
    "actorOntology": {
      "owner": "SURPS",
      "required": true
    },
    "campaignContinuity": {
      "owner": "StoryBuilder",
      "optional": true
    },
    "physics": {
      "owner": "Physics",
      "optional": true
    },
    "presentation": {
      "owner": "Renderer/Visualization",
      "optional": true
    },
    "playerCharacter": {
      "owner": "SURPS",
      "entryPoint": "Surps.Create.PlayerCharacter()",
      "presentationOwner": "GUI",
      "persistence": {
        "format": "SURPS-owned-character-document",
        "operations": [
          "serialize",
          "deserialize"
        ],
        "scope": "player-profile-and-experience-save"
      },
      "experienceConfiguration": "composition.settings.characterCreation",
      "required": true
    }
  },
  "experience": {
    "genre": "tabletop-inspired tactical dungeon adventure",
    "players": "party exploration",
    "resolution": "experience-owned turn adapter",
    "informationModel": [
      "authoritative-world",
      "player-known",
      "discovered",
      "remembered",
      "rumored"
    ]
  },
  "content": {
    "catalogue": "experience-owned-original-content",
    "categories": [
      "scenario",
      "room-style",
      "door-mechanism",
      "trap-mechanism",
      "hazard",
      "treasure-cache",
      "objective",
      "original-character-reference"
    ],
    "noEngineSpecificContentEnums": true
  },
  "firstVerticalSlice": {
    "site": "one-original-compact-underground-site",
    "features": [
      "party movement",
      "hidden-information",
      "door-or-lock-interaction",
      "environmental-hazard",
      "trap-mechanism",
      "meaningful-cache",
      "branching-objective"
    ],
    "deterministicReplayRequired": true
  },
  "ciAi": {
    "eligibleFutureWorkload": true,
    "requiresBuildAndTests": true,
    "requiresContentProvenance": true,
    "requiresHumanApprovalForProtectedActions": true
  },
  "notes": "Design manifest; the quest fixture is a SURPS-enabled composition target. Character creation is a SURPS-owned API/UI/persistence capability and is not implemented by FSM_Dungeon.",
  "composition": {
    "loading": "registered-book-and-experience-contributions",
    "settings": {
      "characterCreation": {
        "enabled": true,
        "profile": "lanternward.adventurer",
        "allowedOrigins": [
          "experience",
          "registered-books"
        ],
        "requireExplicitPlayerConfirmation": true
      }
    },
    "data": {
      "registeredBooks": [
        "fsm-dungeon.book.underground-environments",
        "surps.book.dungeons-and-underground",
        "surps.book.nonplayer-characters"
      ],
      "quest": "fsm-dungeon.quest.lantern-vault"
    },
    "precedence": "explicit-experience-settings-override-book-defaults; conflicts-must-be-reported"
  }
}
